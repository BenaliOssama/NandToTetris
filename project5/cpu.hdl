 //128
 //54
 //4
 // instruction ![6] --> A 
 CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
	//// Replace this comment with your code.
    /*first*/
    Mux16(
        a = instruction,
        b= aluOut,
        sel= instruction[15],
        out= toAregister 
    );
    
    
    Not( in=instruction[15] , out=ngc0 );
    And(a=instruction[15] ,  b=instruction[4] , out=setD );
    /*D*/
    DRegister(in= aluOut,
        load=setD,
        out=toAlu1
    );
    // 
    
    And(a=instruction[15] , b=instruction[5] , out=c0andc12 );
    Or(a= ngc0, b= c0andc12 , out= setA );
    /*A*/
    ARegister(in= toAregister,
        load= setA ,
        out=toMux, out[0..14] =addressM
    );

    /*second*/Mux16(
        a= toMux,
        b= inM,
        sel= instruction[12],
        out= toAlu2
    );

    /*CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];*/
    // instruction 15 and ng or nz i guess thinks like that 
    /*_____________________logic for pc _________________*/
    Or(a= false, b=instruction[2], out= x);
    Or(a=false, b=instruction[1], out=y);
    Or(a=false, b=instruction[0], out=z);

    Not(in=ng , out=nng);
    Not(in=zr , out=nz);
    And(a= nng , b=nz , out=pz );
    //JGT
    And(a=z, b=pz ,out=JGT);

    //JEQ
    And(a=y, b=zr, out=JEQ);

    //JGE
    And(a=y, b=z, out=temp1);
    Or(a=JGT , b=JEQ , out=temp2 );
    And(a=temp1 , b=temp2 , out=JGE);

    //JLT
    And(a=x , b=ng , out=JLT);

    //JNE
    And(a=x , b=z , out=temp3);
    And(a=temp3 , b=nz, out=JNE);

    //JLE
    And(a=x , b=y , out=temp4);
    Or(a=JLT , b=JEQ , out= temp5 );
    And(a=temp5 , b=temp4 , out=JLE );
    
    //JMP
    And(a=x , b=y , out=temp6 );
    And(a=temp6 , b=z , out=JMP );

    Or(a=JGT , b=JEQ , out= jump1 );
    Or(a= jump1, b= JGE, out=jump2);
    Or(a= jump2, b= JLT, out=jump3);

    // can be ignored
    /*Or(a= jump3, b= JNE, out=jump4);
    Or(a= jump4, b= JLE, out=jump5);
    Or(a= jump5, b= JMP, out=jump0);*/

    And(a=instruction[15] , b=jump3 , out=jump );

    Not(in=jump , out= increment);

    PC(
        in=toMux,
        load= jump,
        inc=increment,
        reset=reset,
        out[0..14]=pc
    );
    
    /*________________________ALU________________________*/

    ALU(x=toAlu1, y=toAlu2, 
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9], ny=instruction[8],
        f=instruction[7] , no=instruction[6],
        out=aluOut, out=outM, zr=zr,
        ng=ng );
        

    And(a=instruction[15] , b=instruction[3] , out=writeM );

}
