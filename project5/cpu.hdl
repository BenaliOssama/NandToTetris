// File name: projects/5/CPU.hdl
/**
 * The Hack Central Processing unit (CPU).
 * Parses the binary code in the instruction input and executes it according to the
 * Hack machine language specification. In the case of a C-instruction, computes the
 * function specified by the instruction. If the instruction specifies to read a memory
 * value, the inM input is expected to contain this value. If the instruction specifies
 * to write a value to the memory, sets the outM output to this value, sets the addressM
 * output to the target address, and asserts the writeM output (when writeM = 0, any
 * value may appear in outM).
 * If the reset input is 0, computes the address of the next instruction and sets the
 * pc output to that value. If the reset input is 1, sets pc to 0.
 * Note: The outM and writeM outputs are combinational: they are affected by the
 * instruction's execution during the current cycle. The addressM and pc outputs are
 * clocked: although they are affected by the instruction's execution, they commit to
 * their new values only in the next cycle.
 */
 //346
 // instruction ![6] --> A 
 CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
	//// Replace this comment with your code.
    /*first*/Mux16(
        a = instruction,
        b= aluOut,
        sel= instruction[0],
        out= toAregister 
    );
    Not( in=instruction[0] , out=setA );
    /*D*/Register(in= aluOut,
        load=instruction[11],
        out=toAlu1
    );
    Or(a= setA, b= instruction[10], out=orSetA );
    /*A*/Register(in= toAregister,
        load= orSetA ,
        out=toMux
    );
    /*second*/Mux16(
        a= toMux,
        b= inM,
        sel= instruction[4],
        out= toAlu2
    );
    /*CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];*/
    // instruction 15 and ng or nz i guess thinks like that 
    /*_____________________logic for pc _________________*/
    Or(a= true, b=instruction[13] , out= x);
    Or(a=true, b=instruction[14], out=y);
    Or(a=true, b=instruction[15], out=z);
    Not(in=ng , out=pz);
    Not(in=zr , out=nz);
    //null
    And(a=x , b=y , out=temp1 );
    And(a=temp1 , b=z , out=temp2 );
    Not(in=temp2 , out=null );
    //JGT
    And(a=z , b=pz , out=temp3 );
    Or(a=temp3 , b=null , out=JGT);
    //JEQ
    And(a=y , b=zr , out=temp4);
    Or(a=temp4 , b=JGT , out=JEQ);
    //JGE
    And(a=y , b=z , out=temp5 );
    Or(a=pz , b=zr , out=temp6 );
    And(a=temp5 , b=temp6 , out=temp7);
    Or(a=temp7, b=JEQ , out=JGE);
    //JLT
    And(a=x , b=ng , out=temp8);
    Or(a=temp8 , b=JGE , out=JLT);
    //JNE
    And(a=x , b=z , out=temp9);
    And(a=temp9 , b=nz, out=temp10);
    Or(a=temp10 , b=JLT , out=JNE );
    //JLE
    And(a=x , b=y , out=temp11);
    Or(a=ng , b=zr , out= temp12 );
    And(a=temp11 , b=temp12 , out=temp13 );
    Or(a=temp13 , b=JNE , out=JLE );
    //JMP
    And(a=x , b=y , out=temp14 );
    And(a=temp14 , b=z , out=temp15 );
    Or(a=temp15 , b=JLE , out=JMP );

    PC(
        in=toMux,
        load= JMP,
        inc=true,
        reset=reset,
        out[0..15]=pcOut
    );
    
    /*
        IN  
        x[16], y[16],  // 16-bit inputs        
        zx, // zero the x input?
        nx, // negate the x input?
        zy, // zero the y input?
        ny, // negate the y input?
        f,  // compute (out = x + y) or (out = x & y)?
        no; // negate the out output?
    OUT 
        out[16], // 16-bit output
        zr,      // if (out == 0) equals 1, else 0
        ng;      // if (out < 0)  equals 1, else 0
    */
    ALU(x=toAlu1, y=toAlu2, zx=instruction[4], nx=instruction[5], zy=instruction[6],
        ny=instruction[7], f=instruction[8] , no=instruction[9], out=outM, out=aluOut,
        zr=zr,
    ng=set, ng = ng );
    Or(a= true, b= instruction[12] , out= writeM );
}
