
 //346
 //270
 //142
 //128
 // instruction ![6] --> A 
 CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // Signals whether to re-start the current
                         // program (reset==1) or continue executing
                         // the current program (reset==0).

    OUT outM[16],        // M value output
        writeM,          // Write to M? 
        addressM[15],    // Address in data memory (of M)
        pc[15];          // address of next instruction

    PARTS:
	//// Replace this comment with your code.
    /*first*/
    Mux16(
        a = instruction,
        b= aluOut,
        sel= instruction[15],
        out= toAregister 
    );
    
    Not( in=instruction[15] , out=ngc0 );
    And(a=instruction[15] , b=instruction[4] , out=setD );
    /*D*/
    Register(in= aluOut,
        load=setD,
        out=toAlu1
    );
    // 
    
    And(a=instruction[15] , b=instruction[5] , out=c0andc12 );
    Or(a= ngc0, b= c0andc12 , out= setA );
    /*A*/
    Register(in= toAregister,
        load= setA ,
        out=toMux, out[0..14] =addressM
    );

    /*second*/Mux16(
        a= toMux,
        b= inM,
        sel= instruction[12],
        out= toAlu2
    );

    /*CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];*/
    // instruction 15 and ng or nz i guess thinks like that 
    /*_____________________logic for pc _________________*/
    Or(a= true, b=instruction[2] , out= x);
    Or(a=true, b=instruction[1], out=y);
    Or(a=true, b=instruction[0], out=z);
    Not(in=ng , out=pz);
    Not(in=zr , out=nz);

    //null
    And(a=x , b=y , out=temp1 );
    And(a=temp1 , b=z , out=temp2 );
    Not(in=temp2 , out=null );

    //JGT
    And(a=z , b=pz , out=temp3 );
    Or(a=temp3 , b=null , out=JGT);

    //JEQ
    And(a=y , b=zr , out=temp4);
    Or(a=temp4 , b=JGT , out=JEQ);
    //JGE
    And(a=y , b=z , out=temp5 );
    Or(a=pz , b=zr , out=temp6 );
    And(a=temp5 , b=temp6 , out=temp7);
    Or(a=temp7, b=JEQ , out=JGE);
    //JLT
    And(a=x , b=ng , out=temp8);
    Or(a=temp8 , b=JGE , out=JLT);
    //JNE
    And(a=x , b=z , out=temp9);
    And(a=temp9 , b=nz, out=temp10);
    Or(a=temp10 , b=JLT , out=JNE );
    //JLE
    And(a=x , b=y , out=temp11);
    Or(a=ng , b=zr , out= temp12 );
    And(a=temp11 , b=temp12 , out=temp13 );
    Or(a=temp13 , b=JNE , out=JLE );
    //JMP
    And(a=x , b=y , out=temp14 );
    And(a=temp14 , b=z , out=temp15 );
    Or(a=temp15 , b=JLE , out=JMP );
    And(a=instruction[15] , b=JMP , out=jump );

    PC(
        in=toMux,
        load= jump,
        inc=true,
        reset=reset,
        out[0..14]=pc
    );
    
    /*
        IN  
        x[16], y[16],  // 16-bit inputs        
        zx, // zero the x input?
        nx, // negate the x input?
        zy, // zero the y input?
        ny, // negate the y input?
        f,  // compute (out = x + y) or (out = x & y)? c5 + 4 = c9 
        no; // negate the out output?
    OUT 
        out[16], // 16-bit output
        zr,      // if (out == 0) equals 1, else 0
        ng;      // if (out < 0)  equals 1, else 0
    */

    ALU(x=toAlu1, y=toAlu2, 
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9], ny=instruction[8],
        f=instruction[7] , no=instruction[6],
        out=aluOut, out=outM, zr=zr,
        ng=ng );
        

    And(a=instruction[15] , b=instruction[3] , out=writeM );

}
